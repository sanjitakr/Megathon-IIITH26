# Copy to .env and fill in. Only free tiers are used. With nothing configured the app
# falls back to deterministic template explanations (always number-verified).

# Primary provider: gemini | groq | openrouter | huggingface | ollama | none
LLM_PROVIDER=gemini
# Tried in order if the primary fails or is rate-limited; templates are always the last resort
LLM_FALLBACKS=groq,ollama

GEMINI_API_KEY=
# '-latest' aliases survive Google retiring model names; on a 404 the fallbacks are tried
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest
# low = fast answers (about 3 s instead of 13 s); 'default' lets the model decide
GEMINI_THINKING_LEVEL=low

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

LLM_TIMEOUT_S=60
# Free tiers are rate limited: retry 429s after the suggested delay, and space calls out
LLM_RETRIES=3
LLM_MAX_WAIT_S=65
LLM_MIN_INTERVAL_S=4
